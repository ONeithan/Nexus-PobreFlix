<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>NexusPobreFlix</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.NexusPobreFlix</RootNamespace>

    <Version>1.0.0.15</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <LangVersion>latest</LangVersion>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>NexusPobreFlix</PackageId>
    <Authors>G-Grbz (Core), ONeithan (Nexus PobreFlix Version)</Authors>
    <Company>Nexus PobreFlix</Company>
    <Description>
      O motor visual definitivo do Nexus PobreFlix para Jellyfin. Tradução nativa e tela imersiva Scyfin.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.0" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.0" />
    <PackageReference Include="Jellyfin.Common"    Version="10.11.0" />
    <PackageReference Include="Jellyfin.Data"      Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web/**/*" />
    <EmbeddedResource Include="Resources/**/*" />
    <EmbeddedResource Include="RuntimeModules/**/*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="meta.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Target bash desativado: não funciona no Windows.
       O build.bat atualiza o meta.json automaticamente. -->
  <!--
  <Target Name="UpdateMetaJson"
          BeforeTargets="CopyFilesToOutputDirectory;ComputeFilesToPublish">
    <Message Text="Updating meta.json (timestamp &amp; version &amp; imagePath)..." Importance="high" />
    <Exec Command="bash ./update_meta.sh &quot;$(Version)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  -->

</Project>
